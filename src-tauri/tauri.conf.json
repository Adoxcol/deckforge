{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeckForge",
  "version": "0.4.9",
  "identifier": "org.deckforge.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeckForge — Universal Open-Source Stream Deck Controller",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0B0D14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFQTBCM0FDRTkzNjI5M0MKUldROEtUYnByTE9nL3BjTVZ0M1g2bWJmUk45U1pkMGFpeUZDQ2pScmptUjRjVENvakhhSk5XMEYK",
      "endpoints": [
        "https://github.com/Adoxcol/deckforge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
